# Spoonacular (ingredient catalog + recipe generation)
SPOONACULAR_API_KEY=

# Legacy fallback for both catalog and generation when scoped flags are unset.
SPOONACULAR_MOCK=true

# Scoped flags (recommended):
# - catalog: pantry/profile/staples typeahead
# - generation: bundle recipe generation
SPOONACULAR_MOCK_CATALOG=true
SPOONACULAR_MOCK_GENERATION=true
