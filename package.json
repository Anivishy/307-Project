{
  "name": "307-project",
  "version": "1.0.0",
  "description": "Stack: Next.js Typescript Prisma Supabase",
  "homepage": "https://github.com/Anivishy/307-Project#readme",
  "bugs": {
    "url": "https://github.com/Anivishy/307-Project/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anivishy/307-Project.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "prisma:validate": "prisma validate",
    "test:backend": "npm test --prefix packages/backend",
    "test:frontend": "npm test --prefix packages/react-frontend",
    "build:backend": "npm run build --prefix packages/backend",
    "build:frontend": "npm run build --prefix packages/react-frontend",
    "lint:frontend": "npm run lint --prefix packages/react-frontend",
    "check": "npm run prisma:validate && npm run test:backend && npm run build:backend && npm run test:frontend && npm run lint:frontend && npm run build:frontend"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
