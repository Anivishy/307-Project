{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock-all": "SPOONACULAR_MOCK_CATALOG=true SPOONACULAR_MOCK_GENERATION=true next dev",
    "dev:live-generate": "SPOONACULAR_MOCK_CATALOG=true SPOONACULAR_MOCK_GENERATION=false next dev",
    "dev:live-catalog": "SPOONACULAR_MOCK_CATALOG=false SPOONACULAR_MOCK_GENERATION=true next dev",
    "dev:live-all": "SPOONACULAR_MOCK_CATALOG=false SPOONACULAR_MOCK_GENERATION=false next dev",
    "predev": "npm run prisma:generate",
    "build": "next build",
    "prebuild": "npm run prisma:generate",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "next": "^16.2.7",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "hono": "^4.12.23",
    "postcss": "^8.5.15"
  }
}
